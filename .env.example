# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# The Makefile and Dagster load these; dbt reads them via env_var() in profiles.yml.

# --- BigQuery connection ---------------------------------------------------
# Your GCP project id (BigQuery sandbox is fine — no billing account needed).
DBT_BIGQUERY_PROJECT=

# Absolute path to a service-account JSON key with BigQuery Data Editor + Job User.
# For a personal sandbox you can instead switch profiles.yml to method: oauth
# and run `gcloud auth application-default login` (then this can be left blank).
DBT_BIGQUERY_KEYFILE=C:/Users/Akhil/keys/northwind-sa.json

# Datasets (BigQuery calls schemas "datasets"). Layers get suffixed:
# <dataset>_bronze, <dataset>_silver, <dataset>_gold, <dataset>_marts.
DBT_BIGQUERY_DATASET=northwind_dev
DBT_CI_DATASET=northwind_ci
DBT_BIGQUERY_LOCATION=US

# --- dbt ---
# Points dbt at the in-repo profiles.yml (the Makefile also sets this).
DBT_PROFILES_DIR=./dbt_project
